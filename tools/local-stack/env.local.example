# Ambiente local (emulador). Copie para .env.local. Chaves SOMENTE de desenvolvimento.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_local_somente_desenvolvimento
SUPABASE_SECRET_KEY=sb_secret_local_somente_desenvolvimento
APP_URL=http://localhost:3000
# Emuladores locais do Asaas e do Resend (tools/local-stack/providers-mock.ts). Valores FICTÍCIOS.
ASAAS_ENV=sandbox
ASAAS_BASE_URL=http://127.0.0.1:54321/asaas/v3
ASAAS_API_KEY=asaas_local_somente_desenvolvimento
ASAAS_WEBHOOK_TOKEN=webhook-local-somente-desenvolvimento-0123456789
ASAAS_TRANSFER_VALIDATION_TOKEN=validacao-local-somente-desenvolvimento-0123456789
CRON_SECRET=cron-local-somente-desenvolvimento-0123456789
RESEND_BASE_URL=http://127.0.0.1:54321/resend
RESEND_API_KEY=re_local_somente_desenvolvimento
EMAIL_FROM=Zé do Carro <nao-responda@zedocarro.invalid>
