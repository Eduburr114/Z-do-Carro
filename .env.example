# Produção: valores do projeto Supabase (Settings > API Keys).
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Chave secreta: só no servidor. Usada pelo limite de tentativas e pela fila de push.
SUPABASE_SECRET_KEY=sb_secret_...

# Avisos push (opcional). Gere o par com: pnpm exec web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Endereço do aplicativo ou mailto: do responsável.
VAPID_SUBJECT=

# Endereço público do aplicativo (links nos e-mails).
APP_URL=https://ze-do-carro.fly.dev

# --- Asaas (pagamentos Pix e repasses) — veja docs/FINANCEIRO.md ---------------
# Comece SEMPRE no sandbox (conta em sandbox.asaas.com, chave própria do sandbox).
ASAAS_ENV=sandbox
ASAAS_API_KEY=
# Token que você define ao cadastrar o webhook no Asaas (32 a 255 caracteres, sem espaços).
# Gere com: openssl rand -hex 32
ASAAS_WEBHOOK_TOKEN=
# Mecanismo de validação de saque (recomendado): token próprio, diferente do anterior.
ASAAS_TRANSFER_VALIDATION_TOKEN=

# --- Rotina financeira (prazos, conciliação, estornos, repasses, e-mails) -----
# O agendador chama /api/cron/financeiro com "Authorization: Bearer <CRON_SECRET>".
CRON_SECRET=

# --- Resend (e-mails transacionais) ------------------------------------------
RESEND_API_KEY=
# Remetente de um domínio verificado no Resend.
EMAIL_FROM=Zé do Carro <nao-responda@seu-dominio.com.br>
EMAIL_REPLY_TO=
